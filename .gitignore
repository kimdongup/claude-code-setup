Thumbs.db
._*

# ─────────────────────────────────────────────────────────────
# 데모 결과물 — run-demo.sh 가 매번 새로 만든다
# 커밋하지 않는다
# ─────────────────────────────────────────────────────────────

# 만들어진 할 일 앱 (각 세트별로 생김)
example/*/todo-app/

# 실행 로그 (= 스크린샷 원본)
# walkthrough.html 은 로그에서 생성되지만, 그 자체는 커밋한다
example/*/logs/

# 데모가 남기는 임시 훅 파일
*.hook

# ─────────────────────────────────────────────────────────────
# Claude Code 로컬 파일 — 팀에 공유하지 않는다
# ─────────────────────────────────────────────────────────────

.claude/settings.local.json
.claude/user-team-info.json
.claude/tasks/
.claude/todos/
CLAUDE.local.md

